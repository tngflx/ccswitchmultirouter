{
  "name": "cc-switch-multi",
  "version": "3.20.4-3",
  "description": "All-in-One Assistant for Claude Code, Codex & Gemini CLI",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-tauri-delayed.mjs",
    "dev:delayed": "node scripts/dev-tauri-delayed.mjs",
    "dev:immediate": "node scripts/dev-tauri-delayed.mjs --delay 0",
    "clean:rust-cache": "node scripts/prune-cargo-target.mjs --force",
    "clean:rust-cache:check": "node scripts/prune-cargo-target.mjs --dry-run",
    "build": "node scripts/local-build-pipeline.mjs",
    "watchdog:run": "node scripts/watch-ccswitchmulti.mjs",
    "watchdog:install": "node scripts/install-ccswitchmulti-watchdog.mjs",
    "watchdog:uninstall": "node scripts/install-ccswitchmulti-watchdog.mjs --uninstall",
    "tauri": "tauri",
    "dev:renderer": "vite",
    "build:renderer": "node scripts/build-renderer.mjs",
    "typecheck": "tsc --noEmit",
    "catalog:check": "node scripts/check-codex-catalog-readers.mjs",
    "catalog:test": "node --test scripts/check-codex-catalog-readers.node-test.mjs",
    "catalog:verify": "node scripts/verify-codex-catalog.mjs",
    "contract:check": "node scripts/check-openai-responses-contract.mjs",
    "contract:drift": "node scripts/check-openai-responses-contract.mjs --live",
    "contract:refresh": "node scripts/check-openai-responses-contract.mjs --refresh --accept-reviewed-changes",
    "contract:test": "node --test scripts/check-openai-responses-contract.node-test.mjs",
    "verify:codex-continuation": "node scripts/verify-codex-continuation.mjs",
    "verify:codex-desktop-continuation": "node scripts/verify-codex-desktop-continuation.mjs",
    "git:remotes:install": "node scripts/git-remote-safety.mjs --install",
    "git:remotes:check": "node scripts/git-remote-safety.mjs --check",
    "test:git-remotes": "node --test scripts/git-remote-safety.node-test.mjs scripts/check-upstream-updates.node-test.mjs",
    "upstream:check": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/check-upstream-updates.ps1",
    "canary:search": "python scripts/verify_third_party_hosted_web_search.py",
    "canary:replay": "python scripts/verify_third_party_hosted_web_search.py --suite replay",
    "canary:test": "python -m unittest discover -s scripts/tests -p test_hosted_web_search_canary.py",
    "history:tool:check": "python -m py_compile scripts/codex-history-tool/codex_history_tool.py",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,json}\" \"src-tauri/src/resources/codex_desktop/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,json}\" \"src-tauri/src/resources/codex_desktop/**/*.js\"",
    "release:export": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/export-latest-ccswitchmulti.ps1",
    "release:local": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/local-release-pipeline.ps1",
    "release:local:skip-build": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/local-release-pipeline.ps1 -SkipBuild",
    "cache:clean": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup-cargo-targets.ps1",
    "cache:clean:dry-run": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup-cargo-targets.ps1 -DryRun",
    "release:hook:install": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/install-local-release-hook.ps1",
    "release:hook:install:sync": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/install-local-release-hook.ps1 -Synchronous",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:dev-recovery": "node --test --test-concurrency=1 scripts/dev-tauri-delayed.node-test.mjs scripts/dev-recovery-output.node-test.mjs scripts/dev-recovery-output.integration.node-test.mjs scripts/dev-watchdog-ancestor.integration.node-test.mjs scripts/dev-watchdog-policy.node-test.mjs scripts/prune-cargo-target.node-test.mjs scripts/windows-json-query.node-test.mjs scripts/dev-session-launch.node-test.mjs scripts/dev-app-exit.node-test.mjs scripts/dev-session-takeover.integration.node-test.mjs scripts/dev-watchdog-handoff.integration.node-test.mjs scripts/dev-live-owner-handoff.integration.node-test.mjs",
    "test:lifecycle": "node --test scripts/ccswitchmulti-guardian-core.node-test.mjs scripts/watch-ccswitchmulti.node-test.mjs scripts/install-ccswitchmulti-watchdog.node-test.mjs scripts/local-build-pipeline.node-test.mjs scripts/lifecycle-entrypoints.node-test.mjs",
    "test:runner": "node --test scripts/run-unit-tests.node-test.mjs",
    "test:unit:watch": "vitest watch"
  },
  "keywords": [],
  "author": "Jason Young",
  "license": "MIT",
  "packageManager": "pnpm@12.9.1",
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "^10.6.2",
    "code-inspector-plugin": "^2.0.9",
    "cross-fetch": "^4.1.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "postcss": "8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^6.0.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.23",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-log": "2.10.1",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "flexsearch": "^0.8.212",
    "framer-motion": "^14.6.0",
    "i18next": "^26.5.11",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "recharts": "^3.10.1",
    "smol-toml": "^1.9.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  }
}
