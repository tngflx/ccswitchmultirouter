{
  "name": "cc-switch-multi",
  "version": "3.20.4-2",
  "description": "All-in-One Assistant for Claude Code, Codex & Gemini CLI",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-tauri-delayed.mjs",
    "dev:delayed": "node scripts/dev-tauri-delayed.mjs",
    "dev:immediate": "node scripts/dev-tauri-delayed.mjs --delay 0",
    "clean:rust-cache": "node scripts/prune-cargo-target.mjs --force",
    "clean:rust-cache:check": "node scripts/prune-cargo-target.mjs --dry-run",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-build-pipeline.ps1",
    "tauri": "tauri",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "contract:check": "node scripts/check-openai-responses-contract.mjs",
    "contract:drift": "node scripts/check-openai-responses-contract.mjs --live",
    "contract:refresh": "node scripts/check-openai-responses-contract.mjs --refresh --accept-reviewed-changes",
    "contract:test": "node --test scripts/check-openai-responses-contract.node-test.mjs",
    "canary:search": "python scripts/verify_third_party_hosted_web_search.py",
    "canary:replay": "python scripts/verify_third_party_hosted_web_search.py --suite replay",
    "canary:test": "python -m unittest discover -s scripts/tests -p test_hosted_web_search_canary.py",
    "history:tool:check": "python -m py_compile scripts/codex-history-tool/codex_history_tool.py",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,json}\"",
    "release:export": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-latest-ccswitchmulti.ps1",
    "release:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-release-pipeline.ps1",
    "release:local:skip-build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-release-pipeline.ps1 -SkipBuild",
    "cache:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup-cargo-targets.ps1",
    "cache:clean:dry-run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup-cargo-targets.ps1 -DryRun",
    "release:hook:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local-release-hook.ps1",
    "release:hook:install:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local-release-hook.ps1 -Synchronous",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch"
  },
  "keywords": [],
  "author": "Jason Young",
  "license": "MIT",
  "packageManager": "pnpm@12.9.1",
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "code-inspector-plugin": "^1.6.6",
    "cross-fetch": "^4.1.0",
    "jsdom": "^25.0.1",
    "msw": "^2.15.0",
    "postcss": "8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-log": "2.9.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "2.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "flexsearch": "^0.8.212",
    "framer-motion": "^12.43.0",
    "i18next": "^25.10.10",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^16.6.6",
    "recharts": "^3.10.1",
    "smol-toml": "^1.9.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  }
}
